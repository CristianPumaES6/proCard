# ==============================================================================
#  PRO CARD - ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a `.env` y ajusta los valores según tu entorno:
#   cp .env.example .env
# ==============================================================================

# --- BASE DE DATOS ---
# URL de conexión SQLite para Prisma ORM.
# - Para ejecución local:   file:./dev.db         (se crea en prisma/dev.db)
# - Para Docker Compose:    file:/app/db/dev.db   (dentro del volumen persistente)
DATABASE_URL="file:./dev.db"

# --- PUERTO Y SERVIDOR ---
# Puerto local donde escuchará el servidor Next.js (por defecto: 3000 o 14021)
PORT=14021

# URL pública de la aplicación o API (útil para CORS o accesos remotos)
NEXT_PUBLIC_API_URL="http://localhost:14021"

# --- AUTENTICACIÓN (NEXTAUTH v5) ---
# Secreto criptográfico obligatorio para firmar las cookies y tokens JWT de sesión.
# Genera uno seguro ejecutando en la terminal:
#   openssl rand -hex 32
AUTH_SECRET="769c84976c6943793744d010c7937a6b"

# Habilita la confianza de host en NextAuth si despliegas detrás de un proxy reverso (Nginx, Traefik, Docker)
AUTH_TRUST_HOST=true

# --- CREDENCIALES DE ADMINISTRADOR ---
# Credenciales del usuario administrador para iniciar sesión en /login y administrar los CVs en /dashboard
ADMIN_NAME="Administrador ProCard"
ADMIN_EMAIL="admin@procard.com"
ADMIN_PASSWORD="AdminPassword123!"

# --- AUTENTICACIÓN CON GOOGLE OAUTH (OPCIONAL) ---
# Si deseas habilitar el inicio de sesión con Google OAuth, crea un cliente en:
# https://console.cloud.google.com/apis/credentials
# Si no lo usas, puedes dejar estos campos vacíos o con valores de prueba.
AUTH_GOOGLE_ID="tu-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="tu-google-client-secret"

# --- OPCIONES DE DESPLIEGUE & DOCKER ---
# Establece RUN_SEED=true la primera vez que levantes la app para sembrar los datos y usuarios iniciales.
RUN_SEED=false
