# ==============================================================================
#  PRO CARD - VARIABLES DE ENTORNO PARA DOCKER COMPOSE (.env.docker.example)
# ==============================================================================
# Copia este archivo a `.env` antes de ejecutar `docker compose up -d --build`:
#   cp .env.docker.example .env
# ==============================================================================

# Puerto expuesto en el host (ej. 3000 o 14021)
PORT=14021

# URL pública (déjala vacía si el frontend y backend corren en el mismo contenedor)
NEXT_PUBLIC_API_URL=""

# Secreto obligatorio para firmar las sesiones de NextAuth (genera uno con: openssl rand -hex 32)
AUTH_SECRET="769c84976c6943793744d010c7937a6b"
AUTH_TRUST_HOST=true

# Credenciales de Administrador para login en /login
ADMIN_NAME="Cristian Puma"
ADMIN_EMAIL="cristian.puma.es6@gmail.com"
ADMIN_PASSWORD="AdminPassword123!"

# Credenciales de Google OAuth (opcionales; el login tradicional con email/password funciona sin esto)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Poner en true la primera vez para sembrar los perfiles y usuarios iniciales
RUN_SEED=true
